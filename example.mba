# =============================================
# JOB SCRAPER CONFIG - MBA (ALL SPECIALIZATIONS)
# =============================================
# For: MBA Finance, Marketing, HR, Operations, Analytics, IT, Consulting

# ===========================================
# SEARCH PARAMETERS
# ===========================================
# Main search term - works on most sites
# TIP: Use quotes for exact match, - to exclude words
#
# MBA SEARCH TERM EXAMPLES BY SPECIALIZATION:
#
# 📊 MBA Finance:
#   - "MBA finance intern"
#   - "financial analyst intern"
#   - "investment banking intern"
#   - "equity research intern"
#   - "corporate finance intern"
#   - "finance manager trainee"
#
# 📈 MBA Marketing:
#   - "MBA marketing intern"
#   - "marketing manager trainee"
#   - "brand manager intern"
#   - "digital marketing intern"
#   - "product marketing intern"
#   - "sales and marketing trainee"
#
# 👥 MBA HR (Human Resources):
#   - "MBA HR intern"
#   - "HR manager trainee"
#   - "talent acquisition intern"
#   - "human resources intern"
#   - "recruitment intern"
#   - "HR business partner trainee"
#
# ⚙️ MBA Operations:
#   - "MBA operations intern"
#   - "operations manager trainee"
#   - "supply chain intern"
#   - "logistics intern"
#   - "procurement intern"
#   - "production planning intern"
#
# 💻 MBA IT/Systems:
#   - "MBA IT intern"
#   - "business analyst intern"
#   - "IT project manager trainee"
#   - "systems analyst intern"
#   - "ERP consultant intern"
#
# 📉 MBA Business Analytics:
#   - "business analytics intern"
#   - "data analyst MBA"
#   - "analytics manager trainee"
#   - "business intelligence intern"
#   - "strategy analyst intern"
#
# 🌍 MBA International Business:
#   - "international business intern"
#   - "export import intern"
#   - "trade analyst intern"
#   - "global business trainee"
#
# 🎯 MBA Consulting:
#   - "management consultant intern"
#   - "strategy consultant intern"
#   - "business consultant trainee"
#   - "consulting analyst intern"
#
# 🏢 MBA General Management:
#   - "management trainee"
#   - "business development intern"
#   - "assistant manager trainee"
#   - "general management trainee"

SEARCH_TERM=MBA intern management trainee

# Location (city name works best for Naukri)
LOCATION=Mumbai

# ===========================================
# GOOGLE JOBS SPECIFIC
# ===========================================
# Google needs exact syntax - search on google jobs in browser first,
# apply filters, then copy the search text
GOOGLE_SEARCH_TERM=MBA intern management trainee jobs in Mumbai, India

# ===========================================
# JOB SITES
# ===========================================
# All available sites are automatically used and filtered by country:
#   India: indeed, linkedin, glassdoor, google, naukri, internshala
#   USA: indeed, linkedin, glassdoor, google, zip_recruiter
#   Bangladesh: indeed, linkedin, glassdoor, google, bdjobs
#   Middle East: indeed, linkedin, glassdoor, google, bayt
# No configuration needed - sites are auto-selected based on location

# ===========================================
# SEARCH FILTERS
# ===========================================
# Results per site (hardcoded to 100 for maximum responses)
# RESULTS_WANTED=100

# Jobs posted within last X hours
HOURS_OLD=72

# Country for Indeed & Glassdoor
DEFAULT_COUNTRY=India

# ===========================================
# JOB TYPE
# ===========================================
# Options: fulltime, parttime, internship, contract
# Leave empty for all types
# For MBA students, use 'internship' for summer internships
# Leave empty to get both internships and full-time management trainee roles
JOB_TYPE=internship

# Remote only jobs
IS_REMOTE=false

# ===========================================
# ADVANCED OPTIONS (HARDCODED)
# ===========================================
# These are now hardcoded in the script for optimal performance:
# - DISTANCE: 50 miles
# - VERBOSE: 1 (detailed output)
# - LINKEDIN_FETCH_DESCRIPTION: true (full job descriptions)

# ===========================================
# INTERNSHALA SPECIFIC
# ===========================================
# Internshala category slugs for MBA roles:
#
# 📊 Finance:
#   INTERNSHALA_SEARCH_TERM=finance
#   INTERNSHALA_SEARCH_TERM=accounting-finance
#   INTERNSHALA_SEARCH_TERM=investment-banking
#
# 📈 Marketing:
#   INTERNSHALA_SEARCH_TERM=marketing
#   INTERNSHALA_SEARCH_TERM=digital-marketing
#   INTERNSHALA_SEARCH_TERM=brand-management
#   INTERNSHALA_SEARCH_TERM=sales
#
# 👥 HR:
#   INTERNSHALA_SEARCH_TERM=human-resources
#   INTERNSHALA_SEARCH_TERM=recruitment
#
# ⚙️ Operations:
#   INTERNSHALA_SEARCH_TERM=operations
#   INTERNSHALA_SEARCH_TERM=supply-chain-management
#   INTERNSHALA_SEARCH_TERM=logistics
#
# 📉 Business Analytics:
#   INTERNSHALA_SEARCH_TERM=business-analytics
#   INTERNSHALA_SEARCH_TERM=data-analytics
#   INTERNSHALA_SEARCH_TERM=market-research
#
# 🏢 General/Business Development:
#   INTERNSHALA_SEARCH_TERM=business-development
#   INTERNSHALA_SEARCH_TERM=management
#   INTERNSHALA_SEARCH_TERM=strategy

INTERNSHALA_SEARCH_TERM=business-development


