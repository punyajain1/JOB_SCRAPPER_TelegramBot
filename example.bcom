# =============================================
# JOB SCRAPER CONFIG - B.COM / COMMERCE ROLES
# =============================================
# For: Accounts, Finance, Banking, Commerce freshers/interns

# ===========================================
# SEARCH PARAMETERS
# ===========================================
# Main search term - works on most sites
# TIP: Use quotes for exact match, - to exclude words
# Examples for B.Com:
#   - "accounts intern fresher"
#   - "finance intern"
#   - "accounting executive fresher"
#   - "audit intern"
#   - "tax consultant fresher"
#   - "bookkeeper intern"
SEARCH_TERM=finance intern

# Location (city, state, or country)
LOCATION=India

# ===========================================
# GOOGLE JOBS SPECIFIC
# ===========================================
# Google needs exact syntax - search on google jobs in browser first,
# apply filters, then copy the search text
GOOGLE_SEARCH_TERM=commerce graduate fresher jobs in India

# ===========================================
# JOB SITES
# ===========================================
# All available sites are automatically used and filtered by country:
#   India: indeed, linkedin, glassdoor, google, naukri, internshala
#   USA: indeed, linkedin, glassdoor, google, zip_recruiter
#   Bangladesh: indeed, linkedin, glassdoor, google, bdjobs
#   Middle East: indeed, linkedin, glassdoor, google, bayt
# No configuration needed - sites are auto-selected based on location

# ===========================================
# SEARCH FILTERS
# ===========================================
# Results per site (hardcoded to 100 for maximum responses)
# RESULTS_WANTED=100

# Jobs posted within last X hours
HOURS_OLD=72

# Country for Indeed & Glassdoor
DEFAULT_COUNTRY=India

# ===========================================
# JOB TYPE
# ===========================================
# Options: fulltime, parttime, internship, contract
# Leave empty for all types
# For freshers looking for both jobs & internships, leave empty or use 'internship'
JOB_TYPE=

# Remote only jobs (many accounting jobs can be remote)
IS_REMOTE=false

# ===========================================
# ADVANCED OPTIONS (HARDCODED)
# ===========================================
# These are now hardcoded in the script for optimal performance:
# - DISTANCE: 50 miles
# - VERBOSE: 1 (detailed output)
# - LINKEDIN_FETCH_DESCRIPTION: true (full job descriptions)

# ===========================================
# INTERNSHALA SPECIFIC
# ===========================================
# Category slugs for commerce roles:
#   - accounting-finance (general)
#   - accounts
#   - finance
#   - audit
#   - banking
#   - tax
#   - chartered-accountancy
#   - company-secretary
#   - business-analytics
INTERNSHALA_SEARCH_TERM=accounting-finance


# =============================================
# OTHER B.COM SEARCH TERM EXAMPLES
# =============================================
# Copy any of these to SEARCH_TERM above:
#
# Accounting:
#   accounts intern fresher
#   accountant fresher
#   junior accountant
#   accounts executive intern
#   accounts assistant fresher
#   bookkeeper intern
#
# Finance:
#   finance intern fresher
#   financial analyst intern
#   finance executive fresher
#   investment banking intern
#   equity research intern
#
# Audit & Tax:
#   audit intern
#   internal auditor fresher
#   tax consultant intern
#   GST accountant fresher
#   statutory audit intern
#
# Banking & Insurance:
#   banking operations intern
#   bank clerk fresher
#   insurance executive intern
#   loan officer fresher
#
# CA/CS Related:
#   CA articleship
#   CS intern
#   CA firm intern
#   audit assistant fresher
#
# General Commerce:
#   commerce graduate fresher
#   back office executive intern
#   billing executive fresher
#   MIS executive intern
#   data entry accounts fresher
#
# Tally/SAP:
#   tally operator fresher
#   SAP FICO intern
#   ERP accounts intern
